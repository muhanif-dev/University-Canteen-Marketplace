# MongoDB connection string (Phase 2+)
# Example: mongodb://localhost:27017/university-canteen
# Example (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/university-canteen
MONGODB_URI=

# Authentication secret (required to sign/verify sessions; at least 32 random bytes)
# Generate with: openssl rand -base64 48. Never commit the generated value.
AUTH_SECRET=

# Optional future upload integration (not currently used by the application)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
