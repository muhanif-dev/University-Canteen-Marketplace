# Local MongoDB single-node replica set (required for order transactions)
# mongodb://127.0.0.1:27017/university-canteen?replicaSet=rs0
# For Atlas, copy the connection string from the cluster's Connect > Drivers dialog.
# Keep real Atlas credentials out of this tracked example file.
MONGODB_URI=

# Authentication secret (required to sign/verify sessions; at least 32 random bytes)
# Generate locally with Node.js: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# Never commit the generated value.
AUTH_SECRET=

# Optional future upload integration (not currently used by the application)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
