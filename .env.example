# MongoDB connection string (Phase 2+)
# Example: mongodb://localhost:27017/university-canteen
# Example (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/university-canteen
MONGODB_URI=

# Authentication secret (Phase 3+)
# Generate a strong random string (e.g. 64+ characters). Never commit the real value.
AUTH_SECRET=

# Cloudinary credentials (Phase 6+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
